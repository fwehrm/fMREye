import matplotlib.pyplot as plt
import nibabel as nib
import numpy as np
import pandas as pd
import warnings

from scipy.stats import zscore
from nilearn import plotting, image
from nilearn.maskers import NiftiMasker
from nilearn.masking import apply_mask
from nilearn.glm.first_level import FirstLevelModel, make_first_level_design_matrix
from pathlib import Path

# define subjects & runs
excluded_subs = [
    8, 24, 29, 48,  # technical error during eye-tracking
    4, 6, 13, 14, 16, 42, # calibration error exceeded threshold
    10, 32, 35,  # frame-wise displacement exceeded threshold
    20  # technical problem during pre-processing
]
subjects = [f"S{i:02}" for i in range(1, 51) if i not in excluded_subs]
runs = [1, 2]

# data directories
src_path_nii = Path("data_nii")
src_path_events = Path("data/event_files")

def get_first_level_files(subject):
    """This function loads all files required for the first-level analysis."""
    # initiate storage
    func_files = {run: None for run in runs}
    mo_files = {run: None for run in runs}
    event_files = {run: None for run in runs}

    n_drop = 12 if subject in ['S40', 'S41', 'S42'] else 6

    for run in runs:
        # pull and process functional file (drop either the first 6 or 12 volumes)
        func_file_path = list((src_path_nii / f"{subject}_hipp_epi_matthias_v0_study{run}").glob("swratopup.nii"))
        if not func_file_path:
            raise FileNotFoundError(f"No functional file found for {subject}, run{run}!")
        if len(func_file_path) > 1:
            raise ValueError(f"Multiple functional files found for {subject}, run{run}!")
        img = nib.load(func_file_path[0])
        img_data = img.get_fdata()
        func_file = nib.Nifti1Image(img_data[:, :, :, n_drop:], affine = img.affine, header = img.header)

        # pull and process motion file (add first derivatives and squared first derivatives; drop either the first 6 or 12 rows)
        mo_file_path = list((src_path_nii / f"{subject}_hipp_epi_matthias_v0_study{run}").glob("*.txt"))
        if not mo_file_path:
            raise FileNotFoundError(f"No motion file found for {subject}, run{run}!")
        if len(mo_file_path) > 1:
            raise ValueError(f"Multiple motion files found for {subject}, run{run}!")
        mo_file = pd.read_csv(mo_file_path[0], header = None, sep = r"\s+")
        mo_file = mo_file.iloc[n_drop:].reset_index(drop = True)
        mo_file.columns = ["x", "y", "z", "pitch", "roll", "yaw"]

        d1 = mo_file.diff().fillna(0) # fill first row with zeros
        d1.columns = [f"d1_{c}" for c in mo_file.columns]
        d1_sq = d1.pow(2)
        d1_sq.columns = [f"sq_{c}" for c in d1.columns]
        mo_file = pd.concat([mo_file, d1, d1_sq], axis = 1)

        # pull and process event file
        event_file_path = list((src_path_events / subject).glob(f"*R{run}*"))
        if not event_file_path:
            raise FileNotFoundError(f"No event file found for {subject}, run{run}!")
        if len(event_file_path) > 1:
            raise ValueError(f"Multiple event files found for {subject}, run{run}!")
        event_file = pd.read_csv(event_file_path[0])

        # store files in dict
        func_files[run] = func_file
        mo_files[run] = mo_file
        event_files[run] = event_file

    # pull anatomical file
    anat_file_path = list((src_path_nii / f"{subject}_t1_mprage_sag_p2_0.8iso").glob(f"r2wbs{subject}*.nii"))
    if not anat_file_path:
        raise FileNotFoundError(f"No anatomical file found for {subject}!")
    if len(anat_file_path) > 1:
        raise ValueError(f"Multiple anatomical files found for {subject}!")
    anat_file = nib.load(anat_file_path[0])
    return func_files, anat_file, mo_files, event_files

def extract_wm_nuisance_regressor(subject, func_file):
    """This function extracts the mean white matter signal to create a nuisance regressor."""
    # load and binarize white matter img
    wm_img_path = list((src_path_nii / f"{subject}_t1_mprage_sag_p2_0.8iso").glob("rc2r2func*"))[0]
    wm_img = nib.load(wm_img_path)
    wm_img_bin = image.math_img("img > 0.8", img = wm_img)

    # resample img to fit func img
    wm_img_resampled = image.resample_to_img(
        source_img = wm_img_bin,
        target_img = func_file,
        interpolation = "nearest",
        copy_header = True,
        force_resample = True
    )
    
    # extract mean signal in wm and zscore
    wm_ts = apply_mask(
        imgs = func_file,
        mask_img = wm_img_resampled,
        ensure_finite = True
    ).mean(axis = 1)
    return zscore(wm_ts)


def plot_z_maps(subject, anat_file, z_maps):
    """This function plots all contrast maps for a specified participant."""
    n_maps = len(z_maps)
    fig, ax = plt.subplots(nrows = n_maps, figsize = (14, 4 * (n_maps)), facecolor = "black")

    with warnings.catch_warnings():
        warnings.simplefilter("ignore", category = UserWarning)
        for ax, (contrast_name, z_map) in zip(ax, z_maps.items()):
            plotting.plot_stat_map(
                z_map,
                title = f"{subject}: {contrast_name}",
                threshold = 3.0,
                axes = ax,
                bg_img = anat_file,
                black_bg = True,
                colorbar = True,
                cmap = "cold_hot",
                display_mode = "z",
                cut_coords = list(range(-20, 70, 10))
            )
    plt.show()


def run_first_level_ppi(subject):
    """This function runs the first-level model for one subject."""
     # pull required files
    func_files, anat_file, mo_files, event_files = get_first_level_files(subject)

    # get white matter timeseries and create confound files
    confound_files = {run: None for run in runs}
    for run in runs:
        wm_ts = extract_wm_nuisance_regressor(subject, func_files[run])
        mo_files[run]["white_matter"] = wm_ts
        confound_files[run] = mo_files[run]

    # create design matrices
    TR = 2.029
    design_matrices = {run: None for run in runs}
    for run in runs:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", category = UserWarning)
            dm = make_first_level_design_matrix(
                frame_times = np.arange(func_files[run].shape[-1]) * TR + TR / 2,
                events = event_files[run],
                hrf_model = "spm",
                drift_model = "cosine",   
                high_pass = 1/128,
                add_regs = confound_files[run],
                add_reg_names = confound_files[run].columns
            )
            design_matrices[run] = dm

    # extend design matrices with PPI regressors
    for run in runs:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", category = (UserWarning, DeprecationWarning))
            HC_mask = image.resample_to_img(
                source_img = nib.load("masks/HC_mask_LR.nii"),
                target_img = image.index_img(func_files[run], 0),
                interpolation = "nearest",
                force_resample = True,
                copy_header = True
            )
            HC_masker = NiftiMasker(
                mask_img = HC_mask,
                t_r = TR,
                detrend = False,
                standardize = "zscore_sample"
            )
        
            # 1) extract ROI timeseries
            HC_ts = HC_masker.fit_transform(func_files[run], confounds = confound_files[run]).mean(axis = 1)
            design_matrices[run]["HC"] = HC_ts - HC_ts.mean()

            # 2) define psychological task regressor (durable vs. forgotten)
            task_effect = design_matrices[run]["durable"] - design_matrices[run]["forgotten"]
            task_effect = task_effect - task_effect.mean()

            # 3) create PPI interaction term
            design_matrices[run]["PPI"] = design_matrices[run]["HC"] * task_effect

    # create first-level model
    first_level_model = FirstLevelModel(
        t_r = TR,
        slice_time_ref = 0.5,
        hrf_model = "spm",
        drift_model = "cosine",
        high_pass = 1/128,
        smoothing_fwhm = None
    )

    # fit first-level model with updated design matrices
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", category = UserWarning)
        first_level_model = first_level_model.fit(
            run_imgs = [func_files[run] for run in runs],
            design_matrices = [design_matrices[run] for run in runs]
    )

    # define contrasts
    contrasts = {
        "durable-forgotten": "durable-forgotten",
        "PPI": "PPI"
    }

    # compute contrasts
    z_maps = {contrast_name: None for contrast_name in contrasts}
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", category = (RuntimeWarning, UserWarning))
        for contrast_name, contrast in contrasts.items():
            z_map = first_level_model.compute_contrast(contrast, output_type = "z_score")
            z_maps[contrast_name] = z_map

    # save contrast maps
    nib.save(z_maps["durable-forgotten"], f"PPI_analysis/first_level_analysis/sPPI_results/durable-forgotten/{subject}_durable-forgotten.nii")
    nib.save(z_maps["PPI"], f"PPI_analysis/first_level_analysis/sPPI_results/PPI/{subject}_PPI.nii")

    plot_z_maps(subject, anat_file, z_maps)


# run first-level model for all participants
if __name__ == "__main__":
    for subject in subjects:
        run_first_level_ppi(subject)
